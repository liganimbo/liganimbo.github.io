---
// Marca de la Liga Nimbo: el balón con su halo (el nimbo). Dos piezas:
//   escudo  → emblema principal (foto de perfil, avatar)
//   palabra → logotipo horizontal: LIGA NIMBO, solo texto
// Estilo con degradados: escudo índigo con reflejo, oro degradado, balón con volumen y un resplandor detrás.
// Los colores salen de variables de tema (src/styles/temas.css); sin tema, los valores por defecto de aquí.
// Para tamaños diminutos (pestaña del navegador) está public/favicon.svg.
import Balon from "./marca/Balon.astro";

interface Props {
  variante: "escudo" | "palabra";
  tam?: number;
  /** Lema bajo el logotipo; conviene quitarlo cuando se usa pequeño. */
  lema?: boolean;
}
const { variante, tam = 240, lema = true } = Astro.props;
const uid = `${variante}-${tam}-${lema ? "l" : "s"}`;
const [anchoVB, altoVB] = variante === "palabra" ? [300, lema ? 150 : 132] : [240, 240];
const escudo = "M44 18 H196 Q204 18 204 26 V112 C204 170 166 208 120 228 C74 208 36 170 36 112 V26 Q36 18 44 18 Z";
// Reflejo: la mitad superior del escudo, cortada en diagonal.
const reflejo = "M44 18 H196 Q204 18 204 26 V70 C150 92 92 60 36 96 V26 Q36 18 44 18 Z";
---

<svg width={tam} height={(tam * altoVB) / anchoVB} viewBox={`0 0 ${anchoVB} ${altoVB}`} role="img" aria-label="Liga Nimbo" class="emblema">
  <defs>
    <linearGradient id={`cielo-${uid}`} x1="0" y1="0" x2="0.6" y2="1">
      <stop offset="0" style="stop-color: var(--emb-fondo-1, #4146c4)"></stop>
      <stop offset="1" style="stop-color: var(--emb-fondo-2, #14164a)"></stop>
    </linearGradient>
    <linearGradient id={`oro-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--emb-oro-1, #ffe08a)"></stop>
      <stop offset="1" style="stop-color: var(--emb-oro-2, #f2a516)"></stop>
    </linearGradient>
    <linearGradient id={`nimbo-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.2" style="stop-color: var(--emb-nimbo-1, #ffffff)"></stop>
      <stop offset="1" style="stop-color: var(--emb-nimbo-2, #b9b5ff)"></stop>
    </linearGradient>
    <linearGradient id={`reflejo-${uid}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.16"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id={`brillo-${uid}`}>
      <stop offset="0" style="stop-color: var(--emb-oro-1, #ffe08a); stop-opacity: var(--emb-brillo, 0.45)"></stop>
      <stop offset="1" style="stop-color: var(--emb-oro-1, #ffe08a); stop-opacity: 0"></stop>
    </radialGradient>
    <clipPath id={`dentro-${uid}`}>
      <path d={escudo}></path>
    </clipPath>
  </defs>

  {
    variante === "escudo" && (
      <>
        <path d={escudo} fill={`url(#cielo-${uid})`} stroke={`url(#oro-${uid})`} stroke-width="6" stroke-linejoin="round" />
        <g clip-path={`url(#dentro-${uid})`}>
          <path d={reflejo} fill={`url(#reflejo-${uid})`} />
          <circle cx="120" cy="80" r="62" fill={`url(#brillo-${uid})`} />
          <Balon id={`b-${uid}`} cx={120} cy={86} r={31} />
          <ellipse cx="120" cy="42" rx="27" ry="7" fill="none" stroke={`url(#oro-${uid})`} stroke-width="5" transform="rotate(-8 120 42)" />
        </g>
        <path
          d={escudo}
          fill="none"
          style="stroke: var(--emb-linea, #8f8cff)"
          stroke-width="1.5"
          transform="translate(120 123) scale(0.9) translate(-120 -123)"
          opacity="0.5"
        />
        {/* Cinta con el nombre, que sobresale del escudo */}
        <path d="M12 142 L30 134 V170 L12 178 L21 160 Z" style="fill: var(--emb-pliegue, #b8740a)" />
        <path d="M228 142 L210 134 V170 L228 178 L219 160 Z" style="fill: var(--emb-pliegue, #b8740a)" />
        <rect x="24" y="130" width="192" height="40" rx="4" fill={`url(#oro-${uid})`} />
        <text
          x="120"
          y="161"
          text-anchor="middle"
          font-family="Barlow Condensed, sans-serif"
          font-weight="800"
          font-size="31"
          letter-spacing="3"
          style="fill: var(--emb-texto-cinta, #12142a)"
        >
          LIGA NIMBO
        </text>
        {/* 3x3: nueve puntos */}
        {[0, 1, 2].flatMap((f) =>
          [0, 1, 2].map((c) => (
            <circle
              cx={108 + c * 12}
              cy={186 + f * 11}
              r="3.4"
              style={f === 1 && c === 1 ? "fill: var(--emb-oro-2, #f2a516)" : "fill: var(--emb-linea, #8f8cff)"}
            />
          )),
        )}
      </>
    )
  }

  {
    variante === "palabra" && (
      <>
        <text x="20" y="34" font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="31" letter-spacing="11" fill={`url(#oro-${uid})`}>
          LIGA
        </text>
        <text
          x="16"
          y="118"
          font-family="Barlow Condensed, sans-serif"
          font-weight="800"
          font-style="italic"
          font-size="104"
          letter-spacing="1"
          fill={`url(#nimbo-${uid})`}
        >
          NIMBO
        </text>
        {lema && (
          <text x="20" y="144" font-family="Inter, sans-serif" font-weight="700" font-size="12" letter-spacing="2.6" style="fill: var(--lila, #9b95ff)">
            BALONCESTO 3X3 · CARTAS Y DADOS
          </text>
        )}
      </>
    )
  }
</svg>

<style>
  .emblema {
    display: block;
    flex: none;
  }
</style>
