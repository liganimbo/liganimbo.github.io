---
import Base from "../../layouts/Base.astro";
import Carta from "../../components/Carta.astro";
import Escudo from "../../components/Escudo.astro";
import { perfilEquipo } from "../../motor/mundo.ts";
import { dec, NOMBRES_RONDA, fecha, franquicias, jugadores, mundo, partidosDe, pct, statsRegular, temporada, url } from "../../lib/liga";

export function getStaticPaths() {
  return mundo.franquicias.map((f) => ({ params: { id: f.id } }));
}

const { id } = Astro.params as { id: string };
const f = franquicias[id];
const fila = temporada.clasificacion.find((x) => x.franquicia === id)!;
const plantilla = [...f.plantilla].sort((a, b) => jugadores[b].ataque + jugadores[b].defensa - (jugadores[a].ataque + jugadores[a].defensa));
const sueldos = plantilla.reduce((s, j) => s + jugadores[j].sueldo, 0);
const nivel = (n: number) => "●".repeat(n) + "○".repeat(3 - n);
const partidos = partidosDe(id);
// Próximos partidos de liga, para la pretemporada y para lo que queda de temporada.
const proximos = temporada.calendario
  .slice(temporada.jornadas.length)
  .map((j) => ({ j, cruce: j.cruces.find(([l, v]) => l === id || v === id)! }))
  .slice(0, 5);

const series = temporada.playoffs.rondas.flatMap((r) => r.series.map((s) => ({ ...s, ronda: r.ronda }))).filter((s) => s.alto === id || s.bajo === id);
const ultima = series.at(-1);
const resumenPlayoffs = !ultima
  ? temporada.playoffs.campeon || temporada.playoffs.rondas.length
    ? "Sin playoffs"
    : null
  : temporada.playoffs.campeon === id
    ? "🏆 Campeón de la Liga Nimbo"
    : ultima.ganador === null
      ? `En playoffs: ${NOMBRES_RONDA[ultima.ronda].toLowerCase()}`
      : ultima.ganador === id
        ? `En playoffs: pasa de ${NOMBRES_RONDA[ultima.ronda].toLowerCase()}`
        : `Eliminado en ${NOMBRES_RONDA[ultima.ronda].toLowerCase()}`;
const perfil = perfilEquipo(f, jugadores);
const iconos = [...new Set(perfil.iconos)].map((i) => `${perfil.iconos.filter((x) => x === i).length} ${i}`).join(" · ") || "Ninguno";
---

<Base titulo={`${f.nombre} de ${f.ciudad}`}>
  <section class="cabeza" style={`--c1:${f.colores[0]};--c2:${f.colores[1]}`}>
    <Escudo id={f.id} tam={96} />
    <div>
      <div class="ciudad">{f.ciudad}</div>
      <h1>{f.nombre}</h1>
      <p class="caracter">{f.caracter}</p>
      <div class="resumen">
        {partidos.length ? <span><strong>{fila.v}-{fila.d}</strong> en liga ({fila.posicion}º)</span> : <span>Pretemporada</span>}
        {resumenPlayoffs && <span>{resumenPlayoffs}</span>}
        <span>Mercado {f.mercado}</span>
      </div>
    </div>
  </section>

  <h2>Cómo juega</h2>
  <div class="ficha-equipo">
    <div class="dato"><span class="etq">Perfil</span><strong>{perfil.perfil}</strong><span class="apagado">Ataque {perfil.ataque} · Defensa {perfil.defensa}</span></div>
    <div class="dato"><span class="etq">Estilo</span><strong>{perfil.estilo}</strong><span class="apagado">{Math.round(f.estilo.fuera * 100)}% de tiros de fuera, aprox.</span></div>
    <div class="dato"><span class="etq">Iconos</span><strong>{iconos}</strong><span class="apagado">Especialidades de su plantilla</span></div>
    <div class="dato"><span class="etq">Plantilla</span><strong>{perfil.edadMedia} años de media</strong><span class="apagado">Estrella: {perfil.estrella.nombre}</span></div>
  </div>

  <h2>El club</h2>
  <div class="ficha-equipo">
    <div class="dato"><span class="etq">Presupuesto</span><strong>{f.club.presupuesto ?? "—"}</strong><span class="apagado">{f.club.presupuesto === null ? "Se fija en el primer verano" : `Sueldos ${sueldos} · ahorro ${f.club.ahorro}`}</span></div>
    <div class="dato"><span class="etq">Ojeadores</span><strong class="nivel">{nivel(f.club.ojeadores)}</strong><span class="apagado">Ven el potencial de las promesas del draft</span></div>
    <div class="dato"><span class="etq">Entrenamiento</span><strong class="nivel">{nivel(f.club.entrenamiento)}</strong><span class="apagado">Hace crecer más a las cartas jóvenes</span></div>
  </div>

  <h2>Plantilla</h2>
  <p class="apagado">Sueldos: {sueldos}{f.club.presupuesto !== null ? ` de un presupuesto de ${f.club.presupuesto}` : ""}.</p>
  <div class="mano">
    {
      plantilla.map((jid) => {
        const s = statsRegular[jid];
        return (
          <div class="hueco">
            <Carta j={jugadores[jid]} />
            <div class="linea apagado">
              {s ? `${dec(s.medias.pts)} pts · ${dec(s.medias.paradas)} paradas · ${s.pj} PJ` : "Sin jugar"}
              <br />
              Sueldo {jugadores[jid].sueldo} · {jugadores[jid].contrato} {jugadores[jid].contrato === 1 ? "temporada" : "temporadas"} de contrato
            </div>
          </div>
        );
      })
    }
  </div>

  {
    proximos.length > 0 && (
      <>
        <h2>Próximos partidos</h2>
        <div class="tabla-envoltorio">
          <table>
            <tbody>
              {proximos.map(({ j, cruce }) => {
                const local = cruce[0] === id;
                const rival = local ? cruce[1] : cruce[0];
                return (
                  <tr>
                    <td class="izq apagado">{fecha(j.fecha)}</td>
                    <td class="izq apagado">Jornada {j.jornada}</td>
                    <td class="izq">
                      <span class="apagado">{local ? "vs" : "@"}</span> {franquicias[rival].nombre} de {franquicias[rival].ciudad}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <h2 hidden={partidos.length === 0}>Partidos</h2>
  <div class="tabla-envoltorio" hidden={partidos.length === 0}>
    <table>
      <thead>
        <tr><th>Fecha</th><th class="izq">Competición</th><th class="izq">Rival</th><th>Resultado</th><th class="izq">Mejor del partido</th></tr>
      </thead>
      <tbody>
        {
          partidos.map((p) => {
            const local = p.local === id;
            const rival = local ? p.visitante : p.local;
            const [propio, ajeno] = local ? p.marcador : [p.marcador[1], p.marcador[0]];
            return (
              <tr>
                <td class="izq apagado">{fecha(p.fecha)}</td>
                <td class="izq apagado">{p.contexto}</td>
                <td class="izq">
                  <span class="apagado">{local ? "vs" : "@"}</span> {franquicias[rival].ciudad}
                </td>
                <td>
                  <a href={url(`partidos/${p.id}`)}>
                    <span class={propio > ajeno ? "v" : "d"}>{propio > ajeno ? "V" : "D"}</span> {propio}-{ajeno}
                  </a>
                </td>
                <td class="izq">{jugadores[p.mejor].nombre}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</Base>

<style>
  .cabeza {
    display: flex;
    gap: 24px;
    align-items: center;
    padding: 28px;
    border-radius: 16px;
    color: #fff;
    background: var(--c1);
    border-bottom: 6px solid var(--c2);
  }
  .cabeza h1 {
    font-size: 3rem;
    margin: 0 0 8px;
  }
  .ciudad {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    opacity: 0.85;
  }
  .caracter {
    font-size: 1.1rem;
    margin: 0 0 10px;
    opacity: 0.95;
  }
  .ficha-equipo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }
  .dato {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 16px;
    border-radius: var(--radio);
    background: var(--superficie);
    border: 1px solid var(--borde);
  }
  .dato .etq {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--texto-3);
  }
  .dato strong {
    font-family: var(--titulo);
    font-size: 1.5rem;
    text-transform: uppercase;
  }
  .nivel {
    color: var(--acento);
    letter-spacing: 0.1em;
  }
  .dato .apagado {
    font-size: 0.85rem;
  }
  .resumen {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    opacity: 0.95;
  }
  @media (max-width: 640px) {
    .cabeza {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
  }
  .hueco {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .linea {
    font-size: 0.8rem;
  }
</style>
