---
// Herramienta interna: comparar estilos visuales de las publicaciones (no está en el menú).
import Base from "../layouts/Base.astro";
import { url } from "../lib/liga";

const estilos = [
  { id: "", nombre: "Degradado · por defecto", idea: "Azul noche con degradados suaves y sombras; escudo y logotipo en flat. Todas las publicaciones del día a día." },
  { id: "claro", nombre: "Claro · apertura y finales", idea: "Crema con un halo naranja y tinta oscura; escudo y logotipo en flat. Para las piezas especiales." },
  { id: "flat", nombre: "Flat (anterior)", idea: "Colores planos y sólidos. Sin degradados, sombras ni brillos." },
  { id: "flat-claro", nombre: "Flat claro (anterior)", idea: "La misma limpieza sobre crema, con tinta oscura y naranja." },
  { id: "noche", nombre: "Noche (descartado)", idea: "Como el de por defecto, pero con el escudo también degradado, con brillos y rayos." },
  { id: "vibrante", nombre: "Vibrante (descartado)", idea: "Degradados intensos de morado a rosa y naranja. Pop y llamativo." },
];
const piezas = [
  { ruta: "ig/liga/1", alto: 1350 },
  { ruta: "ig/equipos/1/3", alto: 1350 },
  { ruta: "ig/reglas/6", alto: 1350 },
];
const ESCALA = 0.21;
---

<Base titulo="Estilos">
  <h1>Estilos visuales</h1>
  <p class="subtitulo">Herramienta interna. Las mismas publicaciones en cuatro estilos. Pulsa cualquiera para verla a tamaño real.</p>

  {
    estilos.map((e) => (
      <section class="tarjeta estilo">
        <h2>{e.nombre}</h2>
        <p class="apagado">{e.idea}</p>
        <div class="fila">
          <div class="apertura">
            {[3, 2, 1].reverse().map((n) => (
              <a href={url(`ig/apertura/${n}?tema=${e.id}`)} target="_blank" class="pieza" style={`width:${1080 * ESCALA}px;height:${1440 * ESCALA}px`}>
                <iframe src={url(`ig/apertura/${n}?tema=${e.id}`)} loading="lazy" title={`Apertura ${n}`} style={`height:1440px;transform:scale(${ESCALA})`} />
              </a>
            ))}
          </div>
          {piezas.map((p) => (
            <a href={url(`${p.ruta}?tema=${e.id}`)} target="_blank" class="pieza" style={`width:${1080 * ESCALA}px;height:${p.alto * ESCALA}px`}>
              <iframe src={url(`${p.ruta}?tema=${e.id}`)} loading="lazy" title={p.ruta} style={`height:${p.alto}px;transform:scale(${ESCALA})`} />
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .estilo {
    margin-bottom: 20px;
  }
  .estilo h2 {
    margin: 0 0 4px;
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: flex-start;
    margin-top: 10px;
  }
  .apertura {
    display: flex;
    gap: 2px;
  }
  .pieza {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 6px;
    flex: none;
  }
  .pieza iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1080px;
    border: 0;
    transform-origin: 0 0;
    pointer-events: none;
  }
</style>
