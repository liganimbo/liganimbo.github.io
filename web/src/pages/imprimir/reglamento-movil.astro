---
// Reglamento para leer en el móvil: páginas verticales 9:16, una columna y letra grande. Mismo contenido que el de imprimir
// (sin hojas de partido). El texto fluye de una página a otra; cada caja evita partirse. Se exporta con npm run pdf.
import Impresion from "../../layouts/Impresion.astro";
import Emblema from "../../components/Emblema.astro";
import Naipe from "../../components/Naipe.astro";
import { activas, mundo } from "../../lib/liga";
import { DESCRIPCION_ICONO, REGLAS, VERSION_REGLAMENTO, valorAtaque, valorDefensa } from "../../motor/reglas.ts";
import { CARTAS_POR_EQUIPO, TECHO_MAXIMO } from "../../motor/mundo.ts";
import { CONFIG } from "../../motor/temporada.ts";
import { VERANO } from "../../motor/verano.ts";

const R = REGLAS;
const cartas = activas().sort((a, b) => b.ataque + b.defensa - (a.ataque + a.defensa));
const atacante = cartas.find((j) => j.icono === "Aro" && j.ataque >= 4) ?? cartas[0];
const defensor = cartas.find((j) => j.icono === "Muro" && j.franquicia !== atacante.franquicia) ?? cartas[1];
const dados: [number, number] = [5, 4];
const suma = dados[0] + dados[1];
const ataqueDentro = suma + valorAtaque(atacante, "dentro");
const defensaDentro = valorDefensa(defensor, "dentro", "dentro");
const ataqueFuera = suma + valorAtaque(atacante, "fuera");
const defensaFuera = valorDefensa(defensor, "fuera", "dentro");
const nombre = (n: string) => n.split(" ")[0];
const enPista = CARTAS_POR_EQUIPO - 1;
const mejorDe = (victorias: number) => 2 * victorias - 1;
// Vertical 9:16, como la pantalla de un móvil. La portada va a sangre; el resto, con margen arriba y abajo.
const PAGINAS = "@page { size: 108mm 192mm; margin: 9mm 0 10mm; background: #f8f2e7; } @page :first { margin: 0; }";
---

<Impresion titulo="Reglamento para el móvil" paginas={PAGINAS}>
  <section class="portada">
    <div class="p-arriba">Reglamento · v{VERSION_REGLAMENTO}</div>
    <Emblema variante="escudo" tam={240} />
    <h1>Reglamento</h1>
    <p class="p-lema">Baloncesto 3x3 con cartas y dos dados</p>
    <div class="p-datos">
      <span><strong>2</strong> personas</span>
      <span><strong>5-10</strong> min</span>
      <span><strong>2</strong> dados</span>
    </div>
    <p class="p-texto">Los partidos de la Liga Nimbo se deciden con estas reglas. Con ellas puedes jugarlos tú.</p>
    <div class="p-pie">liganimbo.github.io · @liganimbo</div>
  </section>

  <main class="texto">
    <section>
      <h2><span class="num">1</span> Lo esencial</h2>
      <ul class="caja">
        <li>Cada equipo tiene <strong>{CARTAS_POR_EQUIPO} cartas</strong>: {enPista} en pista y 1 suplente.</li>
        <li>Cada carta tiene <strong>Ataque</strong> y <strong>Defensa</strong>, y a veces un <strong>icono</strong>.</li>
        <li>Cada carta tiene <strong>{R.fichasPorCarta} tiros</strong>. Cada equipo ataca <strong>{R.ataquesPorEquipo} veces</strong>, por turnos.</li>
        <li>Quien ataca elige en secreto <strong>dentro</strong> ({R.puntos.dentro} puntos) o <strong>fuera</strong> ({R.puntos.fuera}). Quien defiende, qué <strong>cierra</strong>.</li>
        <li>Se revela, se tiran <strong>dos dados</strong> y se mira si entra.</li>
        <li>A mitad de partido <strong>el suplente entra</strong> obligatoriamente.</li>
      </ul>
      <div class="gana">Gana quien más puntos tenga tras {R.ataquesPorEquipo} ataques cada uno</div>
    </section>

    <section>
      <h2><span class="num">2</span> Qué necesitas</h2>
      <dl class="lista">
        <div><dt>{CARTAS_POR_EQUIPO} cartas por persona</dt><dd>Una franquicia cada una. Están en el PDF de las cartas.</dd></div>
        <div><dt>Dos dados</dt><dd>De seis caras, los de toda la vida.</dd></div>
        <div><dt>{CARTAS_POR_EQUIPO * R.fichasPorCarta} fichas por persona</dt><dd>Monedas o garbanzos: son los tiros.</dd></div>
        <div><dt>Papel y lápiz</dt><dd>Para el marcador.</dd></div>
      </dl>
    </section>

    <section>
      <h2><span class="num">3</span> Las cartas</h2>
      <div class="centro"><Naipe j={atacante} /></div>
    </section>
    <section>
      <dl class="lista">
        <div><dt>Ataque</dt><dd>Lo que suma cuando tira. Del 2 al 6.</dd></div>
        <div><dt>Defensa</dt><dd>Lo que suma cuando marca a quien tira. Del 2 al 6.</dd></div>
        <div><dt>Icono</dt><dd>Algunas cartas, como mucho uno.</dd></div>
        <div><dt>Tiros</dt><dd>Cada carta empieza con {R.fichasPorCarta} fichas y gasta una cada vez que tira. Sin fichas ya no tira, pero sigue defendiendo.</dd></div>
      </dl>
    </section>
    <section class="caja iconos">
      {
        (["Tiro", "Aro", "Muro"] as const).map((i) => (
          <div>
            <span class="pastilla">{i}</span>
            {DESCRIPCION_ICONO[i]}.
          </div>
        ))
      }
    </section>
    <p class="pequeño">Edad, origen, historia y techo son de la liga y sirven entre temporadas. La liga es mixta y el género nunca interviene en los números.</p>

    <section>
      <h2><span class="num">4</span> Preparación</h2>
      <ol class="pasos">
        <li>Cada equipo pone <strong>{enPista} cartas en pista</strong> y deja <strong>1 de suplente</strong>, con sus fichas al lado.</li>
        <li><strong>Marcajes:</strong> cada equipo decide en secreto a qué rival marca cada uno de sus {enPista} jugadores. Se revelan a la vez.</li>
        <li>Se sortea quién ataca primero.</li>
      </ol>
    </section>

    <section>
      <h2><span class="num">5</span> Cada ataque es un farol</h2>
      <div class="lado ataca">
        <div class="etq">Quien ataca</div>
        <p>Elige <strong>quién tira</strong> (con fichas) y gasta una. En secreto elige:</p>
        <div class="opcion">Dentro <span>{R.puntos.dentro} puntos</span></div>
        <div class="opcion">Fuera <span>{R.puntos.fuera} puntos</span></div>
      </div>
    </section>
    <section>
      <div class="lado defiende">
        <div class="etq">Quien defiende</div>
        <p>Elige en secreto <strong>qué cierra</strong>. Si acierta, su defensa suma +{R.bonusCierre}.</p>
        <div class="opcion">Cierra dentro</div>
        <div class="opcion">Cierra fuera</div>
      </div>
      <p class="pequeño">Para elegir en secreto: cartas boca abajo o una moneda en la mano. Se revela a la vez y se tiran los dados.</p>
    </section>

    <section>
      <h2><span class="num">6</span> La cuenta</h2>
      <div class="formula">
        <div class="etq">Ataque</div>
        <div class="f-linea"><b>Dos dados</b> + <b>Ataque</b> de quien tira</div>
        <div class="f-extra">+{R.bonusAro} si es Aro y tira dentro<br />+{R.bonusTiro} si es Tiro y tira fuera</div>
      </div>
      <div class="formula">
        <div class="etq">Defensa</div>
        <div class="f-linea"><b>{R.baseDefensa}</b> + <b>Defensa</b> de quien le marca</div>
        <div class="f-extra">+{R.bonusMuro} si es Muro y el tiro es de dentro<br />+{R.bonusCierre} si ha cerrado lo que era</div>
      </div>
    </section>
    <section class="caja">
      <p><span class="pastilla naranja">Dentro</span> entra si el ataque <strong>iguala o supera</strong> a la defensa: <strong>{R.puntos.dentro} puntos</strong>.</p>
      <p class="sin-margen"><span class="pastilla indigo">Fuera</span> entra si el ataque <strong>supera a la defensa por {R.margenFuera} o más</strong>: <strong>{R.puntos.fuera} puntos</strong>.</p>
    </section>

    <section class="oscura">
      <h3>Mates y tapones</h3>
      <p>No cambian el marcador, pero se cantan y se apuntan.</p>
      <p><strong>Mate:</strong> canasta de dentro que supera a la defensa por <strong>{R.margenMate} o más</strong>.</p>
      <p class="sin-margen"><strong>Tapón:</strong> tiro de dentro que se queda corto por <strong>{R.margenTapon} o más</strong>. Lo pone quien marcaba.</p>
    </section>

    <section>
      <h2><span class="num">7</span> Un ejemplo</h2>
      <div class="ej-cartas">
        <Naipe j={atacante} />
        <Naipe j={defensor} />
      </div>
    </section>
    <section class="caja">
      <ol class="pasos">
        <li>{nombre(atacante.nombre)} tira <strong>dentro</strong>. La defensa lo lee y <strong>cierra dentro</strong>.</li>
        <li>Salen un <span class="dado">{dados[0]}</span> y un <span class="dado">{dados[1]}</span>. Ataque: {suma} + {atacante.ataque} + {valorAtaque(atacante, "dentro") - atacante.ataque} (Aro) = <strong>{ataqueDentro}</strong>.</li>
        <li>Defensa de {nombre(defensor.nombre)}: {R.baseDefensa} + {defensor.defensa} + {R.bonusMuro} (Muro) + {R.bonusCierre} (lo adivinó) = <strong>{defensaDentro}</strong>.</li>
      </ol>
      <p class="ej-final">{ataqueDentro >= defensaDentro ? `${ataqueDentro} contra ${defensaDentro}: canasta de 2` : `${ataqueDentro} contra ${defensaDentro}: no entra`}</p>
      <p class="pequeño sin-margen">
        ¿Y si hubiera tirado de fuera? Perdía el Aro (ataque {ataqueFuera}), pero el Muro no frena los triples y la defensa había
        cerrado dentro: se quedaba en {defensaFuera} y le bastaba con {defensaFuera + R.margenFuera}.{" "}
        {ataqueFuera >= defensaFuera + R.margenFuera ? "Habría sido triple." : "Tampoco entraba."}
      </p>
    </section>

    <section>
      <h2><span class="num">8</span> Descanso y final</h2>
      <dl class="lista">
        <div>
          <dt>Descanso</dt>
          <dd>Cuando los dos equipos han hecho {R.descansoTras} ataques. <strong>El suplente entra obligatoriamente</strong>, con sus fichas. Solo puede salir quien ya haya gastado las suyas. Después se rehacen los marcajes.</dd>
        </div>
        <div><dt>Tiempo muerto</dt><dd>Una vez por partido, cada equipo puede repetir una tirada de ataque propia que haya fallado.</dd></div>
        <div><dt>Final</dt><dd>Gana quien más puntos tenga cuando los dos equipos han hecho sus {R.ataquesPorEquipo} ataques.</dd></div>
      </dl>
    </section>
    <section>
      <dl class="lista">
        <div><dt>Muerte súbita</dt><dd>Si hay empate, un ataque más por equipo, siguiendo el turno. Puede tirar cualquiera de pista, tenga fichas o no. Se repite hasta que alguien vaya por delante.</dd></div>
        <div><dt>Mejor del partido</dt><dd>Más puntos anotados, más 1 por cada ataque rival que no entre estando marcado por esa carta.</dd></div>
      </dl>
    </section>

    <section>
      <h2><span class="num">9</span> Lo que importa</h2>
      <dl class="lista">
        <div><dt>¿Cuándo gastas a tu estrella?</dt><dd>Sus dos tiros al principio, para coger ventaja, o guardados para el final.</dd></div>
        <div><dt>¿Quién sale en el descanso?</dt><dd>Solo sale quien ya no tiene tiros. Si tu mejor atacante defiende mal, gasta pronto sus fichas.</dd></div>
        <div><dt>¿A quién marcas?</dt><dd>Tu mejor defensa sobre su mejor tirador… o sobre quien aún tiene fichas.</dd></div>
        <div><dt>¿Dentro o fuera?</dt><dd>Ir a lo seguro o leerle la mente al rival. Ahí está el juego.</dd></div>
      </dl>
    </section>

    <section>
      <h2><span class="num">10</span> Tu propia liga</h2>
      <ul class="caja">
        <li><strong>Liga regular</strong> a ida y vuelta: {2 * (mundo.franquicias.length - 1)} jornadas.</li>
        <li><strong>Playoffs</strong> para las {CONFIG.playoffs} mejores: {`cuartos y semifinales al mejor de ${mejorDe(CONFIG.victoriasPorRonda.cuartos)}, la Final al mejor de ${mejorDe(CONFIG.victoriasPorRonda.final)}`}.</li>
        <li><strong>El verano:</strong> cada carta tira un dado. Las jóvenes (hasta {VERANO.edadJoven}) mejoran, las veteranas (desde {VERANO.edadVeterana}) se desgastan. Nadie pasa de su techo (como mucho, {TECHO_MAXIMO}).</li>
      </ul>
    </section>

    <section class="oscura oficial">
      <Emblema variante="escudo" tam={90} />
      <h3>Y así se juega la liga oficial</h3>
      <p class="sin-margen">
        Con estas mismas reglas y cartas. El motor juega el plan de cada franquicia con una semilla pública, y en el acta de cada
        partido están todas las tiradas. Todo en <strong>liganimbo.github.io</strong>.
      </p>
    </section>

    <section>
      <h2><span class="num">R</span> Referencia rápida</h2>
      <div class="formula">
        <div class="etq">Ataque</div>
        <div class="f-linea"><b>2 dados + Ataque</b></div>
        <div class="f-extra">+{R.bonusAro} Aro (dentro) · +{R.bonusTiro} Tiro (fuera)</div>
      </div>
      <div class="formula">
        <div class="etq">Defensa</div>
        <div class="f-linea"><b>{R.baseDefensa} + Defensa</b></div>
        <div class="f-extra">+{R.bonusMuro} Muro (dentro) · +{R.bonusCierre} si cerró lo que era</div>
      </div>
      <div class="formula">
        <div class="etq">¿Entra?</div>
        <div class="f-linea">Dentro, igualar: <b>{R.puntos.dentro}</b></div>
        <div class="f-linea">Fuera, superar por {R.margenFuera}: <b>{R.puntos.fuera}</b></div>
      </div>
    </section>
  </main>
</Impresion>

<style>
  :global(html:root),
  :global(html:root body) {
    background: #f8f2e7;
  }
  :global(body) {
    font-size: 4.6mm;
    line-height: 1.45;
  }

  /* Portada, a sangre */
  .portada {
    width: 108mm;
    height: 192mm;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 9mm 8mm 8mm;
    text-align: center;
    color: #f1f2f8;
    background: radial-gradient(circle at 50% 30%, #3a3590 0%, #1f1d5a 30%, #0d0f1c 65%);
    break-after: page;
  }
  .p-arriba {
    font-size: 3.4mm;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffc83d;
    margin-bottom: 14mm;
  }
  .portada .emblema {
    width: 62mm;
    height: auto;
  }
  .portada h1 {
    font-size: 19mm;
    margin-top: 7mm;
  }
  .p-lema {
    font-size: 4.6mm;
    color: #d6d8f2;
    margin: 2mm 0 6mm;
  }
  .p-datos {
    display: flex;
    gap: 2mm;
  }
  .p-datos span {
    padding: 1.4mm 3.4mm;
    border-radius: 999px;
    background: #262857;
    font-size: 3.6mm;
  }
  .p-datos strong {
    color: #ffc83d;
  }
  .p-texto {
    margin-top: auto;
    font-size: 4.2mm;
    color: #b9b5ff;
  }
  .p-pie {
    font-size: 3.2mm;
    color: #8d8fae;
  }

  /* Interior: una columna que fluye; ningún bloque se parte entre páginas. */
  .texto {
    padding: 0 7mm;
    color: var(--tinta);
  }
  .caja,
  .formula,
  .lista > div,
  .lado,
  .oscura,
  .gana,
  .ej-cartas,
  .centro,
  .pasos li {
    break-inside: avoid;
  }
  section + section {
    margin-top: 4mm;
  }
  h2 {
    display: flex;
    align-items: center;
    gap: 2.5mm;
    font-size: 9mm;
    line-height: 1.15;
    margin: 6mm 0 3.5mm;
    break-after: avoid;
  }
  h3 {
    font-size: 6.5mm;
    margin-bottom: 2mm;
  }
  .num {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 8.5mm;
    height: 8.5mm;
    border-radius: 50%;
    background: linear-gradient(180deg, #ffe08a, #f2a516);
    color: #16182e;
    font-size: 5.2mm;
  }
  p {
    margin: 0 0 3mm;
  }
  .sin-margen {
    margin: 0;
  }
  .pequeño {
    font-size: 3.9mm;
    color: var(--tinta-2);
  }
  .caja,
  .formula,
  .lista > div,
  .lado {
    background: #fffdf8;
    border: 0.3mm solid var(--linea);
    border-radius: 3mm;
  }
  .caja {
    padding: 4mm 5mm;
    margin: 0;
  }
  ul.caja {
    padding-left: 9mm;
  }
  .caja li,
  .pasos li {
    margin-bottom: 2mm;
  }
  .gana {
    margin-top: 3mm;
    padding: 3mm 4mm;
    border-radius: 2.5mm;
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 5.6mm;
    line-height: 1.05;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(100deg, #e8590c, #f2a516);
  }
  .lista {
    display: flex;
    flex-direction: column;
    gap: 2.5mm;
    margin: 0;
  }
  .lista > div {
    padding: 3mm 4.5mm;
  }
  .lista dt {
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 5.6mm;
    line-height: 1.05;
    text-transform: uppercase;
    margin-bottom: 1mm;
  }
  .lista dd {
    margin: 0;
  }
  .centro {
    display: flex;
    justify-content: center;
  }
  .iconos {
    display: flex;
    flex-direction: column;
    gap: 2.5mm;
  }
  .pastilla {
    display: inline-block;
    min-width: 15mm;
    margin-right: 2mm;
    padding: 0.4mm 2.5mm;
    border-radius: 999px;
    font-size: 3.2mm;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
    background: linear-gradient(180deg, #ffe08a, #f2a516);
    color: #16182e;
  }
  .pastilla.naranja {
    background: linear-gradient(180deg, #f47a2c, #c94d0b);
    color: #fff;
  }
  .pastilla.indigo {
    background: linear-gradient(180deg, #4b4fe0, #2a2f8e);
    color: #fff;
  }
  .pasos {
    margin: 0;
    padding-left: 6mm;
  }
  .etq {
    font-size: 3.3mm;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--naranja);
    margin-bottom: 1mm;
  }
  .lado {
    padding: 4mm 5mm;
  }
  .opcion {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2mm;
    padding: 2.4mm 4mm;
    border-radius: 2.5mm;
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 6.5mm;
    text-transform: uppercase;
    color: #fff;
  }
  .opcion span {
    font-family: Inter, sans-serif;
    font-size: 3.6mm;
    font-weight: 600;
    text-transform: none;
  }
  .ataca .opcion {
    background: linear-gradient(100deg, #f47a2c, #c94d0b);
  }
  .defiende .opcion {
    background: linear-gradient(100deg, #4b4fe0, #1d2060);
  }
  .lado + .pequeño {
    margin-top: 3mm;
  }
  .formula {
    padding: 3.5mm 5mm;
  }
  .formula + .formula {
    margin-top: 2.5mm;
  }
  .f-linea {
    font-size: 5mm;
  }
  .f-linea b {
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 1.2em;
    text-transform: uppercase;
  }
  .f-extra {
    margin-top: 1mm;
    font-size: 3.9mm;
    color: var(--tinta-2);
  }
  .caja .pastilla + strong,
  .caja p {
    line-height: 1.5;
  }
  .oscura {
    padding: 5mm;
    border-radius: 3mm;
    color: #f1f2f8;
    background: radial-gradient(circle at 100% 0%, #5b5288 0%, #2a2f6e 40%, #12142a 100%);
  }
  .oscura h3,
  .oscura strong {
    color: #ffc83d;
  }
  .oscura p {
    color: #d6d8f2;
  }
  .oficial {
    background: radial-gradient(circle at 100% 0%, #3d39a8 0%, #1a1a4a 45%, #0d0f1c 85%);
  }
  .oficial .emblema {
    width: 24mm;
    height: auto;
    margin-bottom: 2mm;
  }
  .ej-cartas {
    display: flex;
    justify-content: center;
    gap: 3mm;
    zoom: 0.73;
  }
  .dado {
    display: inline-grid;
    place-items: center;
    width: 6mm;
    height: 6mm;
    border-radius: 1.4mm;
    background: #fff;
    border: 0.35mm solid var(--tinta);
    font-weight: 800;
    font-size: 3.8mm;
  }
  .ej-final {
    margin: 3mm 0 2mm;
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 7mm;
    line-height: 1;
    text-transform: uppercase;
    color: var(--naranja);
  }
</style>
