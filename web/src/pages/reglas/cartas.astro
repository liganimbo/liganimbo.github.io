---
// Cartas para imprimir y jugar en casa (63×88 mm, tamaño de carta de juego), más cartas de elección y hoja de partido.
import Base from "../../layouts/Base.astro";
import Escudo from "../../components/Escudo.astro";
import { jugadores, mundo, url } from "../../lib/liga";
import { DESCRIPCION_ICONO, REGLAS } from "../../motor/reglas.ts";
import { perfilEquipo } from "../../motor/mundo.ts";

const fichas = "○".repeat(REGLAS.fichasPorCarta);
---

<Base titulo="Cartas para imprimir">
  <div class="solo-pantalla">
    <h1>Cartas para imprimir</h1>
    <p class="subtitulo">
      Las 48 cartas de la liga a tamaño de carta de juego (63×88 mm). Imprime en A4, recorta y juega con dos dados. Las reglas,
      <a href={url("reglas")}>aquí</a>.
    </p>
    <p>
      <a class="boton" href={url("descargas/liga-nimbo-cartas.pdf")} download>Descargar el PDF maquetado</a>
      <button class="boton secundario" onclick="window.print()">Imprimir esta página</button>
    </p>
    <p class="apagado nota">
      El PDF trae las cartas de partido, cartas en blanco y los dorsos. Si imprimes esta página, activa «Gráficos de fondo» para que
      salgan los colores.
    </p>
  </div>

  {
    mundo.franquicias.map((f) => {
      const p = perfilEquipo(f, jugadores);
      return (
        <section class="equipo" style={`--c1:${f.colores[0]};--c2:${f.colores[1]}`}>
          <h2 class="cab">
            <Escudo id={f.id} tam={26} /> {f.nombre} de {f.ciudad}
            <span class="apagado estilo">
              {p.perfil} · {p.estilo}
            </span>
          </h2>
          <div class="hoja">
            {f.plantilla.map((id) => {
              const j = jugadores[id];
              return (
                <div class="naipe">
                  <div class="naipe-cab">
                    <span>{f.id}</span>
                    {j.icono && <span class="naipe-icono">{j.icono}</span>}
                  </div>
                  <div class="naipe-nombre">{j.nombre}</div>
                  <div class="naipe-meta">
                    {f.nombre} · {j.edad} años
                  </div>
                  <div class="naipe-numeros">
                    <div>
                      <span>{j.ataque}</span>
                      <small>Ataque</small>
                    </div>
                    <div>
                      <span>{j.defensa}</span>
                      <small>Defensa</small>
                    </div>
                  </div>
                  <div class="naipe-pie">
                    <span class="naipe-regla">{j.icono ? `${DESCRIPCION_ICONO[j.icono]}` : "Sin icono"}</span>
                    <span class="naipe-fichas">{fichas}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      );
    })
  }

  <section class="equipo">
    <h2 class="cab">Cartas de elección <span class="apagado estilo">un juego por persona</span></h2>
    <div class="hoja">
      {
        ["Dentro", "Fuera"].map((t) => (
          <div class="naipe eleccion">
            <div class="eleccion-texto">{t}</div>
            <div class="naipe-meta">{t === "Dentro" ? `Ataque: tiro de ${REGLAS.puntos.dentro} · Defensa: cierro dentro` : `Ataque: tiro de ${REGLAS.puntos.fuera} · Defensa: cierro fuera`}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="equipo hoja-partido">
    <h2 class="cab">Hoja de partido</h2>
    <table>
      <thead>
        <tr>
          <th>Equipo</th>
          {Array.from({ length: REGLAS.ataquesPorEquipo }, (_, i) => <th>{i + 1}</th>)}
          <th>Extra</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {[1, 2].map(() => (
          <tr>
            <td class="nombre-equipo" />
            {Array.from({ length: REGLAS.ataquesPorEquipo + 2 }, () => <td />)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="recordatorio">
      Descanso tras {REGLAS.descansoTras} ataques por equipo: entra el suplente. Ataque = dados + Ataque (+ icono). Defensa = {REGLAS.baseDefensa} + Defensa (+ Muro si es dentro) (+{REGLAS.bonusCierre} si lo adivina). Fuera hay que superar por {REGLAS.margenFuera}. Un tiempo muerto por equipo.
    </p>
  </section>
</Base>

<style>
  .boton {
    font: inherit;
    font-weight: 700;
    color: var(--sobre-acento);
    background: var(--acento);
    border: 0;
    padding: 9px 16px;
    border-radius: 8px;
    cursor: pointer;
  }
  a.boton {
    display: inline-block;
  }
  .boton.secundario {
    color: var(--texto);
    background: var(--superficie-2);
  }
  .nota {
    font-size: 0.85rem;
  }
  .equipo {
    break-inside: avoid;
    margin-top: 24px;
  }
  .cab {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.2rem;
    margin: 0 0 10px;
  }
  .estilo {
    font-family: Inter, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: none;
  }
  .hoja {
    display: flex;
    flex-wrap: wrap;
    gap: 4mm;
  }

  /* Naipe: 63×88 mm, colores impresos tal cual. */
  .naipe {
    width: 63mm;
    height: 88mm;
    display: flex;
    flex-direction: column;
    border: 0.6mm solid var(--c1, #16182e);
    border-radius: 3.5mm;
    background: #fff;
    color: #16182e;
    overflow: hidden;
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  .naipe-cab {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2.5mm 3.5mm;
    background: var(--c1);
    color: var(--c2);
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 5mm;
    letter-spacing: 0.06em;
  }
  .naipe-icono {
    font-family: Inter, sans-serif;
    font-size: 2.6mm;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.6mm 2.2mm;
    border-radius: 999px;
    background: var(--c2);
    color: var(--c1);
  }
  .naipe-nombre {
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 6.2mm;
    line-height: 1;
    text-transform: uppercase;
    padding: 3mm 3.5mm 0;
  }
  .naipe-meta {
    font-size: 2.8mm;
    color: #6b7084;
    padding: 1.2mm 3.5mm 0;
  }
  .naipe-numeros {
    margin-top: auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2mm;
    padding: 0 3.5mm;
  }
  .naipe-numeros div {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #f1ece0;
    border-radius: 2mm;
    padding: 1.5mm 0;
  }
  .naipe-numeros span {
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 13mm;
    line-height: 1;
  }
  .naipe-numeros small {
    font-size: 2.3mm;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6b7084;
  }
  .naipe-pie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2mm;
    padding: 2.5mm 3.5mm 3mm;
    font-size: 2.6mm;
    color: #4a4c63;
  }
  .naipe-fichas {
    font-size: 4.5mm;
    letter-spacing: 0.5mm;
    color: #e8590c;
  }
  .eleccion {
    border-color: #16182e;
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .eleccion-texto {
    font-family: var(--titulo);
    font-weight: 800;
    font-size: 15mm;
    text-transform: uppercase;
  }
  .hoja-partido table {
    width: 100%;
    max-width: 190mm;
    background: #fff;
    color: #16182e;
  }
  .hoja-partido th,
  .hoja-partido td {
    border: 0.3mm solid #c9c2b3;
    height: 10mm;
    text-align: center;
    background: #fff;
  }
  .hoja-partido .nombre-equipo {
    width: 45mm;
  }
  .recordatorio {
    font-size: 0.8rem;
    max-width: 190mm;
  }

  /* Al imprimir: todas las cartas seguidas, 3×3 por hoja A4, y la hoja de partido aparte. */
  @media print {
    @page {
      size: A4;
      margin: 8mm;
    }
    :global(.cabecera),
    :global(.pie),
    .solo-pantalla,
    .cab {
      display: none !important;
    }
    :global(body) {
      background: #fff !important;
      color: #16182e;
    }
    :global(main.contenedor) {
      display: grid;
      grid-template-columns: repeat(3, 63mm);
      gap: 2mm;
      justify-content: center;
      padding: 0;
      max-width: none;
    }
    .equipo,
    .hoja {
      display: contents;
    }
    .naipe {
      break-inside: avoid;
    }
    .equipo.hoja-partido {
      display: block;
      grid-column: 1 / -1;
      break-before: page;
    }
    .hoja-partido .cab {
      display: flex !important;
    }
  }
</style>
