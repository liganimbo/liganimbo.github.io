---
// Foto de perfil de Instagram (1080×1080). Instagram la recorta en círculo: el logo (flat) queda dentro con margen, sobre un fondo con degradado.
import Emblema from "../../components/Emblema.astro";
import "../../styles/temas.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Avatar · Liga Nimbo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,700;0,800;1,800&family=Inter:wght@700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Emblema variante="escudo" tam={780} />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 1080px;
    height: 1080px;
    overflow: hidden;
  }
  body {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 50% 32%, #5048c8 0%, transparent 52%),
      radial-gradient(circle at 15% 90%, rgb(155 149 255 / 38%), transparent 50%),
      radial-gradient(circle at 85% 12%, rgb(255 200 61 / 35%), transparent 42%),
      #14163a;
  }
</style>
