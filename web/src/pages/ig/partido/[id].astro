---
import Instagram from "../../../layouts/Instagram.astro";
import Escudo from "../../../components/Escudo.astro";
import { franquicias, jugadores, todosLosPartidos } from "../../../lib/liga";
import { jugadaDecisiva, remontada } from "../../../lib/instagram";
import { partido, temporada } from "../../../lib/liga";

export function getStaticPaths() {
  return todosLosPartidos().map((r) => ({ params: { id: r.id }, props: { r } }));
}

const { r } = Astro.props;
const p = partido(r.id);
const ganador = p.marcador[0] > p.marcador[1] ? 0 : 1;
const lados = [p.local, p.visitante];
const ganadorId = lados[ganador];
const mejor = p.estadisticas[p.mejor];
const decisiva = jugadaDecisiva(p);
const vuelta = remontada(p);
const prorroga = p.jugadas.length > 16;

// ¿Es el partido que decide el título?
const finalSerie = temporada.playoffs.rondas.find((x) => x.ronda === "final")?.series[0];
const decideTitulo = !!finalSerie?.ganador && finalSerie.partidos.at(-1) === r.id;
const titular = decideTitulo
  ? `¡${franquicias[ganadorId].nombre}, campeones de la Liga Nimbo!`
  : prorroga
  ? "Decidido en la muerte súbita"
  : vuelta >= 5
    ? `Remontada de ${vuelta} puntos`
    : Math.abs(p.marcador[0] - p.marcador[1]) <= 2
      ? "Hasta el último tiro"
      : `Victoria de ${franquicias[ganadorId].nombre}`;
const tipo = (j: { tipo: string; anota: boolean }) => (j.tipo === "fuera" ? "un triple" : "una canasta dentro");
---

<Instagram tema={r.id.includes("-PO-F-") ? "claro" : undefined} titulo={`${p.visitante} ${p.marcador[1]}-${p.marcador[0]} ${p.local}`} acento={franquicias[ganadorId].colores[0]} etiqueta={r.contexto.split(" · ")[0]}>
  <div class="antetitulo cabecera">Final · {titular}</div>

  <section class="marcador">
    {
      [1, 0].map((lado) => (
        <div class:list={["equipo", { pierde: lado !== ganador }]}>
          <Escudo id={lados[lado]} tam={190} />
          <div class="ciudad">{franquicias[lados[lado]].ciudad}</div>
          <div class="nombre">{franquicias[lados[lado]].nombre}</div>
          <div class="pts">{p.marcador[lado]}</div>
        </div>
      ))
    }
  </section>

  <section class="datos">
    {
      decisiva && (
        <div class="bloque">
          <div class="etq">La jugada</div>
          <div class="valor">
            {jugadores[decisiva.jugada.tirador].nombre} mete {tipo(decisiva.jugada)} y pone por delante a los {franquicias[ganadorId].nombre}
            <span class="dados">
              <span>{decisiva.jugada.dados[0]}</span>
              <span>{decisiva.jugada.dados[1]}</span>
            </span>
          </div>
          <div class="suave sub">{decisiva.quedaban === 0
              ? "En el último ataque del partido."
              : decisiva.quedaban === 1
                ? "Quedaba un ataque y ya no soltaron el mando."
                : `Quedaban ${decisiva.quedaban} ataques y ya no soltaron el mando.`}</div>
        </div>
      )
    }
    <div class="bloque">
      <div class="etq">★ Mejor del partido</div>
      <div class="valor">{jugadores[p.mejor].nombre}</div>
      <div class="suave sub">{mejor.pts} puntos · {mejor.paradas} {mejor.paradas === 1 ? "parada" : "paradas"}</div>
    </div>
  </section>
</Instagram>

<style>
  .cabecera {
    margin-top: 56px;
  }
  .marcador {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 40px;
  }
  .equipo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .equipo.pierde {
    opacity: 0.55;
  }
  .ciudad {
    font-size: 26px;
    color: color-mix(in srgb, var(--texto) 65%, transparent);
    margin-top: 18px;
  }
  .nombre {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 64px;
    text-transform: uppercase;
    line-height: 1;
  }
  .pts {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 220px;
    line-height: 0.9;
    margin-top: 8px;
  }
  .datos {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-top: 48px;
  }
  .bloque {
    padding: 26px 30px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--texto) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--texto) 10%, transparent);
  }
  .etq {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oro);
  }
  .valor {
    font-size: 34px;
    font-weight: 700;
    margin-top: 6px;
    line-height: 1.25;
  }
  .sub {
    font-size: 24px;
    margin-top: 4px;
  }
  .dados {
    display: inline-flex;
    gap: 8px;
    margin-left: 14px;
    vertical-align: middle;
  }
  .dados span {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: #fff;
    color: #0d0f1c;
    box-shadow: 0 2px 10px rgb(0 0 0 / 18%);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 32px;
  }
</style>
