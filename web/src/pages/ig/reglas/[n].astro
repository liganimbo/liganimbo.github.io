  }
  .reglas-tiro {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-top: 44px;
    font-size: 34px;
    line-height: 1.35;
  }
  .reglas-tiro .pastilla {
    margin-right: 16px;
  }
  .ejemplo {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    margin: 36px 0 10px;
    height: 310px;
  }
  .ejemplo .contra {
    align-self: center;
  }
  .ejemplo .mini {
    width: 245px;
  }
  .ejemplo .mini :global(.carta-ig) {
    scale: 0.58;
  }
  .pasos {
    margin: 0;
    padding-left: 38px;
    font-size: 31px;
    line-height: 1.45;
  }
  .pasos li + li {
    margin-top: 10px;
  }
  .pasos .resultado {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 54px;
    font-weight: 800;
    text-transform: uppercase;
    color: #4ade80;
    list-style: none;
    margin-left: -38px;
    margin-top: 18px;
  }
  .pasos .resultado.falla {
    color: #f87171;
  }
</style>
