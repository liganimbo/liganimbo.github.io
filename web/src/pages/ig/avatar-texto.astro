---
// Alternativa de foto de perfil (1080×1080): LIGA NIMBO apilado con el balón y su halo encima. Con degradados, como el escudo y el logotipo.
import Balon from "../../components/marca/Balon.astro";
import "../../styles/temas.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Avatar con texto · Liga Nimbo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,800;1,800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <svg width="1080" height="1080" viewBox="0 0 1080 1080" role="img" aria-label="Liga Nimbo">
      <defs>
        <linearGradient id="halo" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffe08a"></stop>
          <stop offset="1" stop-color="#f2a516"></stop>
        </linearGradient>
        <linearGradient id="oro" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#ffe08a"></stop>
          <stop offset="1" stop-color="#f2a516"></stop>
        </linearGradient>
        <linearGradient id="nimbo" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0.2" stop-color="#ffffff"></stop>
          <stop offset="1" stop-color="#b9b5ff"></stop>
        </linearGradient>
        <radialGradient id="resplandor">
          <stop offset="0" stop-color="#ffc83d" stop-opacity="0.35"></stop>
          <stop offset="1" stop-color="#ffc83d" stop-opacity="0"></stop>
        </radialGradient>
      </defs>
      <circle cx="540" cy="350" r="190" fill="url(#resplandor)"></circle>
      <ellipse cx="540" cy="232" rx="92" ry="22" fill="none" stroke="url(#halo)" stroke-width="16" transform="rotate(-8 540 232)"></ellipse>
      <Balon id="avatar" cx={540} cy={370} r={105} />
      <text x="540" y="590" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="800" font-size="110" letter-spacing="46" fill="url(#oro)">LIGA</text>
      <text x="540" y="830" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="800" font-style="italic" font-size="290" fill="url(#nimbo)">NIMBO</text>
    </svg>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 1080px;
    height: 1080px;
    overflow: hidden;
  }
  body {
    background:
      radial-gradient(circle at 50% 32%, #5048c8 0%, transparent 52%),
      radial-gradient(circle at 15% 90%, rgb(155 149 255 / 38%), transparent 50%),
      radial-gradient(circle at 85% 12%, rgb(255 200 61 / 35%), transparent 42%),
      #14163a;
  }
</style>
