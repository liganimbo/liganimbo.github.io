---
// Carrusel de Instagram que explica cómo funciona la liga. Fechas, jornadas y formato salen de los datos.
import Instagram from "../../../layouts/Instagram.astro";
import Escudo from "../../../components/Escudo.astro";
import CartaGrande from "../../../components/ig/CartaGrande.astro";
import { activas, fecha, franquicias, jugadores, mundo, temporada } from "../../../lib/liga";
import { CONFIG } from "../../../motor/temporada.ts";
import { CARTAS_POR_EQUIPO } from "../../../motor/mundo.ts";

export function getStaticPaths() {
  return Array.from({ length: 8 }, (_, i) => ({ params: { n: String(i + 1) } }));
}

const TOTAL = 8;
const n = Number(Astro.params.n);
const cartas = activas();
const jugadoras = cartas.filter((j) => j.genero === "f").length;
const numFranquicias = mundo.franquicias.length;
const jornadas = temporada.calendario.length;
const inicio = temporada.calendario[0].fecha;
const finLiga = temporada.calendario.at(-1)!.fecha;
const partidosPorEquipo = (numFranquicias - 1) * 2;
const mejorDe = (victorias: number) => victorias * 2 - 1;
// Las primeras elecciones del draft de fundación que siguen en un equipo.
const primeras = mundo.draftFundacion.elecciones.filter((e) => jugadores[e.jugador].estado === "activa" && franquicias[jugadores[e.jugador].franquicia]).slice(0, 3);
const mes = (iso: string) => new Date(`${iso}T12:00:00`).toLocaleDateString("es-ES", { month: "long" });
---

<Instagram titulo={`La liga ${n}/${TOTAL}`} etiqueta={`La liga · ${n}/${TOTAL}`}>
  {
    n === 1 && (
      <section class="portada">
        <div class="antetitulo">Temporada {CONFIG.temporada}</div>
        <h1 class="titular grande">
          Cómo
          <br />
          funciona
          <br />
          <span class="lila">la liga</span>
        </h1>
        <p class="entradilla">{numFranquicias} franquicias, {cartas.length} cartas y una pregunta: ¿quién se lleva La Nube?</p>
        <div class="escudos-portada">
          {mundo.franquicias.slice(0, 6).map((f) => <Escudo id={f.id} tam={96} />)}
        </div>
        <div class="desliza">Desliza →</div>
      </section>
    )
  }

  {
    n === 2 && (
      <section class="diapo">
        <div class="paso">1</div>
        <h1 class="titular">{numFranquicias} franquicias</h1>
        <p class="entradilla">Doce ciudades ficticias, cada una con su carácter. Los nombres y colores son provisionales: los decidirá la afición.</p>
        <div class="rejilla-equipos">
          {mundo.franquicias.map((f) => (
            <div class="equipo">
              <Escudo id={f.id} tam={70} />
              <div>
                <div class="eq-nombre">{f.nombre}</div>
                <div class="suave eq-ciudad">{f.ciudad}</div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    n === 3 && (
      <section class="diapo">
        <div class="paso">2</div>
        <h1 class="titular">{cartas.length} cartas.<br />Liga mixta.</h1>
        <div class="cifras">
          <div><span>{jugadoras}</span>jugadoras</div>
          <div><span>{cartas.length - jugadoras}</span>jugadores</div>
          <div><span>{CARTAS_POR_EQUIPO}</span>por equipo</div>
        </div>
        <p class="texto">
          Las plantillas salieron de un <strong>draft de fundación</strong>: {mundo.draftFundacion.elecciones.length / numFranquicias} rondas en serpiente en las que cada franquicia elegía sin conocer del todo el potencial de las cartas.
        </p>
        <div class="tres-cartas">
          {primeras.map((e) => (
            <div class="mini">
              <div class="suave num-pick">Elección {e.numero}</div>
              <CartaGrande j={jugadores[e.jugador]} />
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    n === 4 && (
      <section class="diapo">
        <div class="paso">3</div>
        <h1 class="titular">La temporada</h1>
        <div class="linea-tiempo">
          <div class="hito">
            <span class="grande-num">{jornadas}</span>
            <span>jornadas, de {mes(inicio)} a {mes(finLiga)}</span>
          </div>
          <div class="hito">
            <span class="grande-num">{partidosPorEquipo}</span>
            <span>partidos por equipo: todos contra todos, en casa y fuera</span>
          </div>
          <div class="hito">
            <span class="grande-num">2</span>
            <span>Noches Nimbo por semana: <strong>martes y viernes</strong></span>
          </div>
        </div>
        <p class="texto">Primera jornada: {fecha(inicio)}. Resultados, partido destacado y clasificación, aquí mismo, cada semana.</p>
      </section>
    )
  }

  {
    n === 5 && (
      <section class="diapo">
        <div class="paso">4</div>
        <h1 class="titular">Playoffs</h1>
        <p class="entradilla">Los <strong>{CONFIG.playoffs} primeros</strong> de la liga regular pelean por el título.</p>
        <div class="cuadro">
          <div class="ronda">
            <div class="etq">Cuartos</div>
            <div class="huecos">
              <div class="cruce">1º vs 8º</div>
              <div class="cruce">4º vs 5º</div>
              <div class="cruce">2º vs 7º</div>
              <div class="cruce">3º vs 6º</div>
            </div>
            <div class="suave mejor-de">Al mejor de {mejorDe(CONFIG.victoriasPorRonda.cuartos)}</div>
          </div>
          <div class="ronda">
            <div class="etq">Semifinales</div>
            <div class="huecos">
              <div class="cruce hueco" />
              <div class="cruce hueco" />
            </div>
            <div class="suave mejor-de">Al mejor de {mejorDe(CONFIG.victoriasPorRonda.semifinales)}</div>
          </div>
          <div class="ronda">
            <div class="etq">Finales Nimbo</div>
            <div class="huecos">
              <div class="cruce hueco final" />
            </div>
            <div class="suave mejor-de">Al mejor de {mejorDe(CONFIG.victoriasPorRonda.final)}</div>
          </div>
        </div>
        <p class="texto">Quien gane se lleva <strong class="oro">La Nube</strong>, el trofeo de campeón. El mejor clasificado juega más partidos en casa.</p>
      </section>
    )
  }

  {
    n === 6 && (
      <section class="diapo">
        <div class="paso">5</div>
        <h1 class="titular">Cada partido<br />se juega de verdad</h1>
        <ul class="puntos">
          <li>Con <strong>las mismas reglas y las mismas cartas</strong> que puedes usar tú en la web.</li>
          <li>Cada franquicia tiene <strong>su estilo de juego</strong>: unas viven del triple, otras del juego cerca del aro.</li>
          <li>Los dados tienen <strong>semilla pública</strong>: cualquiera puede comprobar cada resultado.</li>
          <li>En la web está el <strong>acta jugada a jugada</strong>, con los dados de cada tiro.</li>
        </ul>
        <div class="dados-fila">
          <span>3</span><span>6</span><span>1</span><span>5</span><span>6</span><span>6</span>
        </div>
      </section>
    )
  }

  {
    n === 7 && (
      <section class="diapo">
        <div class="paso">6</div>
        <h1 class="titular">Y tú,<br />¿qué pintas?</h1>
        <div class="roles">
          <div class="rol">
            <div class="etq">Afición <span class="estado ya">Ya</span></div>
            <p>Elige equipo, sigue la liga, comenta y opina.</p>
          </div>
          <div class="rol">
            <div class="etq">Juega <span class="estado ya">Ya</span></div>
            <p>Imprime las cartas reales desde la web y juega tú cualquier partido de la liga.</p>
          </div>
          <div class="rol pronto">
            <div class="etq">Socios y dirección deportiva <span class="estado">Próximamente</span></div>
            <p>Votar las decisiones de tu franquicia y preparar el plan de cada partido.</p>
          </div>
          <div class="rol pronto">
            <div class="etq">Porra Nimbo <span class="estado">Próximamente</span></div>
            <p>Acertar resultados. Premio: crear una carta del próximo draft.</p>
          </div>
        </div>
      </section>
    )
  }

  {
    n === 8 && (
      <section class="portada">
        <div class="antetitulo">Empieza ya</div>
        <h1 class="titular grande">
          Elige
          <br />
          tu equipo
        </h1>
        <p class="entradilla">Dinos en comentarios con qué franquicia vas. La afición de cada ciudad empieza aquí.</p>
        <div class="escudos-final">{mundo.franquicias.map((f) => <Escudo id={f.id} tam={66} />)}</div>
        <ul class="puntos lista-cta">
          <li>🔗 Juega y sigue la liga: enlace en la bio</li>
          <li>📖 ¿Cómo se juega? Mira el carrusel de reglas</li>
        </ul>
      </section>
    )
  }
</Instagram>

<style>
  .portada,
  .diapo {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .portada {
    justify-content: center;
  }
  .diapo {
    margin-top: 36px;
  }
  .titular {
    font-size: 104px;
  }
  .titular.grande {
    font-size: 150px;
    margin: 12px 0 28px;
  }
  .lila {
    color: var(--lila);
  }
  .oro {
    color: var(--oro);
  }
  .entradilla {
    font-size: 34px;
    line-height: 1.35;
    color: color-mix(in srgb, var(--texto) 80%, transparent);
    margin: 14px 0 0;
    max-width: 900px;
  }
  .texto {
    font-size: 30px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--texto) 80%, transparent);
    margin-top: 30px;
  }
  .paso {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 40px;
    font-weight: 800;
    background: var(--oro);
    color: var(--sobre-oro);
    margin-bottom: 18px;
  }
  .desliza {
    margin-top: 48px;
    font-size: 30px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--oro);
  }
  .etq {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--oro);
  }
  .escudos-portada {
    display: flex;
    gap: 22px;
    margin-top: 44px;
  }
  .rejilla-equipos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 28px;
    margin-top: 40px;
  }
  .equipo {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .eq-nombre {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 40px;
    text-transform: uppercase;
    line-height: 1;
  }
  .eq-ciudad {
    font-size: 22px;
    margin-top: 2px;
  }
  .cifras {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 36px;
  }
  .cifras div {
    display: flex;
    flex-direction: column;
    padding: 20px 24px;
    border-radius: 22px;
    background: color-mix(in srgb, var(--texto) 7%, transparent);
    font-size: 26px;
    color: color-mix(in srgb, var(--texto) 75%, transparent);
  }
  .cifras span {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 96px;
    line-height: 1;
    color: var(--texto);
  }
  .tres-cartas {
    display: flex;
    gap: 30px;
    margin-top: 16px;
  }
  .tres-cartas .mini {
    width: 260px;
  }
  .tres-cartas :global(.carta-ig) {
    transform-origin: top left;
    scale: 0.6;
  }
  .num-pick {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .linea-tiempo {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin-top: 40px;
  }
  .hito {
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 22px 30px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--texto) 7%, transparent);
    font-size: 34px;
    line-height: 1.3;
  }
  .grande-num {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 110px;
    line-height: 1;
    min-width: 130px;
    color: var(--oro);
  }
  .cuadro {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr;
    gap: 22px;
    margin-top: 36px;
  }
  .ronda {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .huecos {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: 14px;
  }
  .cruce {
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 700;
    font-size: 38px;
    padding: 14px 20px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--texto) 9%, transparent);
    min-height: 66px;
  }
  .cruce.hueco {
    border: 2px dashed color-mix(in srgb, var(--texto) 25%, transparent);
    background: none;
    min-height: 120px;
  }
  .cruce.final {
    min-height: 200px;
    border-color: var(--oro);
  }
  .mejor-de {
    font-size: 22px;
  }
  .puntos {
    margin: 36px 0 0;
    padding-left: 34px;
    font-size: 33px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--texto) 85%, transparent);
  }
  .puntos li + li {
    margin-top: 20px;
  }
  .dados-fila {
    display: flex;
    gap: 16px;
    margin-top: 48px;
  }
  .dados-fila span {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 16px;
    background: #fff;
    color: #0d0f1c;
    box-shadow: 0 2px 10px rgb(0 0 0 / 18%);
    font-family: "Barlow Condensed", sans-serif;
    font-weight: 800;
    font-size: 56px;
  }
  .dados-fila span:nth-child(odd) {
    rotate: -6deg;
  }
  .dados-fila span:nth-child(even) {
    rotate: 5deg;
  }
  .roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 40px;
  }
  .rol {
    padding: 26px 28px;
    border-radius: 24px;
    background: color-mix(in srgb, var(--texto) 7%, transparent);
  }
  .rol.pronto {
    background: none;
    border: 2px dashed color-mix(in srgb, var(--texto) 20%, transparent);
  }
  .estado {
    display: inline-block;
    margin-left: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 16px;
    letter-spacing: 0.08em;
    background: color-mix(in srgb, var(--texto) 15%, transparent);
    color: var(--texto);
    vertical-align: 2px;
  }
  .estado.ya {
    background: #4ade80;
    color: var(--sobre-oro);
  }
  .rol p {
    margin: 10px 0 0;
    font-size: 30px;
    line-height: 1.35;
  }
  .escudos-final {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
    margin-top: 40px;
  }
  .lista-cta {
    list-style: none;
    padding: 0;
  }
</style>
