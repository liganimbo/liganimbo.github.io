---
import Instagram from "../../../layouts/Instagram.astro";
import CartaGrande from "../../../components/ig/CartaGrande.astro";
import { dec, franquicias, jugadores, mundo } from "../../../lib/liga";
import { statsDe } from "../../../lib/instagram";
import { DESCRIPCION_ICONO } from "../../../motor/reglas.ts";

export function getStaticPaths() {
  return Object.keys(mundo.jugadores).map((id) => ({ params: { id } }));
}

const { id } = Astro.params as { id: string };
const j = jugadores[id];
const f = franquicias[j.franquicia];
const s = statsDe(id);
const [nombre, ...apellidos] = j.nombre.split(" ");
---

<Instagram titulo={j.nombre} acento={f.colores[0]} etiqueta="Presentamos">
  <div class="cuerpo">
    <div class="carta"><CartaGrande j={j} giro={-4} /></div>
    <div class="texto">
      <div class="antetitulo">{f.nombre} de {f.ciudad}</div>
      <h1 class="titular">{nombre}<br />{apellidos.join(" ")}</h1>
      <p class="historia">“{j.historia}”</p>
      <ul>
        {j.icono && <li><strong>{j.icono}:</strong> {DESCRIPCION_ICONO[j.icono]}</li>}
        {j.rasgo && <li><strong>{j.rasgo}:</strong> {mundo.rasgos[j.rasgo].toLowerCase()}</li>}
        {s && <li><strong>Temporada:</strong> {dec(s.medias.pts)} puntos y {dec(s.medias.paradas)} {s.medias.paradas === 1 ? "parada" : "paradas"} por partido</li>}
      </ul>
    </div>
  </div>
</Instagram>

<style>
  .cuerpo {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 56px;
  }
  .carta {
    align-self: center;
    scale: 1.12;
  }
  .titular {
    font-size: 112px;
    margin-top: 10px;
  }
  .historia {
    font-size: 30px;
    font-style: italic;
    line-height: 1.35;
    color: color-mix(in srgb, var(--texto) 80%, transparent);
    margin: 22px 0 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 26px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--texto) 75%, transparent);
  }
  strong {
    color: var(--texto);
  }
</style>
