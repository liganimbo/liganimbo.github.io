---
import Base from "../../layouts/Base.astro";
import Cronica from "../../components/Cronica.astro";
import { fecha, franquicias, partido, todosLosPartidos } from "../../lib/liga";

export function getStaticPaths() {
  return todosLosPartidos().map((resumen) => ({ params: { id: resumen.id }, props: { resumen } }));
}

const { resumen } = Astro.props;
const p = partido(resumen.id);
---

<Base titulo={`${franquicias[p.local].nombre} ${p.marcador[0]}-${p.marcador[1]} ${franquicias[p.visitante].nombre}`}>
  <Cronica p={p} contexto={`${resumen.contexto} · ${fecha(p.fecha)} · Pista de ${franquicias[p.local].ciudad}`} />
</Base>
